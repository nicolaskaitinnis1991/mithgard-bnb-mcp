{
  "name": "@mithgard/bnb-mcp",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Production-grade MCP server for Airbnb hosts. 2 live tools on public data, 7 demo tools showcasing Partner-API-grade host workflows.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "airbnb",
    "claude",
    "ai-agent",
    "host-tools",
    "vacation-rental"
  ],
  "author": "Nico Kaitinnis <nicolaskaitinnis1991@gmail.com> (https://mithgard.ai)",
  "homepage": "https://github.com/nicolaskaitinnis1991/mithgard-bnb-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolaskaitinnis1991/mithgard-bnb-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nicolaskaitinnis1991/mithgard-bnb-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "bin": {
    "mithgard-bnb-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cheerio": "^1.0.0",
    "lru-cache": "^11.0.0",
    "p-queue": "^8.0.0",
    "pino": "^9.0.0",
    "undici": "^6.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "msw": "^2.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml}": [
      "prettier --write"
    ]
  }
}
