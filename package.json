{
  "name": "@mithgard/bnb-mcp",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "MCP server for public Airbnb data, supplied-data host analysis, bounded workflows and local operations.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "airbnb",
    "claude",
    "ai-agent",
    "host-tools",
    "vacation-rental"
  ],
  "author": "Nico Kaitinnis <nicolaskaitinnis1991@gmail.com> (https://mithgard.ai)",
  "homepage": "https://github.com/nicolaskaitinnis1991/mithgard-bnb-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolaskaitinnis1991/mithgard-bnb-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/nicolaskaitinnis1991/mithgard-bnb-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "dist/index.js",
  "bin": {
    "mithgard-bnb-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "docs:index": "node scripts/index-repository.mjs",
    "docs:check": "node scripts/index-repository.mjs --check",
    "smoke": "node scripts/smoke.mjs",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "verify": "npm run test:evidence && npm run lint && npm run typecheck && npm run test:cov && npm run build && npm run docs:check && npm run smoke && npm run test:stress",
    "prepare": "husky",
    "acceptance": "node scripts/acceptance.mjs",
    "test:evidence": "node --test scripts/evidence.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cheerio": "^1.0.0",
    "lru-cache": "^11.0.0",
    "p-queue": "^8.0.0",
    "pino": "^9.0.0",
    "undici": "^6.0.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "msw": "^2.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml}": [
      "prettier --write"
    ]
  }
}
