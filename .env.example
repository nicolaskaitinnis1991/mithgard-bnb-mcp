# Logging to stderr
LOG_LEVEL=info
# In-memory cache
CACHE_TTL_SEARCH_MS=900000
CACHE_TTL_LISTING_MS=1800000
CACHE_MAX_SEARCH=500
CACHE_MAX_LISTING=500
# Public HTTP quotas and bounds
HTTP_RATE_PER_SEC=1
HTTP_RATE_PER_HOUR=60
HTTP_TIMEOUT_MS=15000
HTTP_MAX_QUEUE_SIZE=64
HTTP_MAX_RESPONSE_BYTES=2000000
HTTP_MAX_RETRIES=3
HTTP_MAX_RETRY_AFTER_MS=60000
